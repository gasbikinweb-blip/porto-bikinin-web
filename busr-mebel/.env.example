# PERHATIAN: semua variabel NEXT_PUBLIC_* ikut dibundel ke JavaScript dan BERSIFAT PUBLIK.
# Jangan pernah menaruh secret (API key privat, password, token) di sini.
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_NAME=Busr Mebel
# Format internasional tanpa + dan spasi. Nomor WA memang publik (tampil di tombol), bukan secret.
NEXT_PUBLIC_WA_NUMBER=6282231807569
