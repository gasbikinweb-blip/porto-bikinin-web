# PERHATIAN: semua variabel NEXT_PUBLIC_* ikut dibundel ke JavaScript dan BERSIFAT PUBLIK.
# Jangan pernah menaruh secret (API key privat, password, token) di sini.
# Salin file ini menjadi .env.local lalu isi nilainya.

# Domain website (dipakai untuk canonical URL, sitemap, dan OpenGraph)
NEXT_PUBLIC_SITE_URL=https://syroster-industrie.example.com
NEXT_PUBLIC_SITE_NAME=Syroster Industrie
# Format internasional tanpa + dan spasi (contoh: 628123456789). Nomor WA memang publik, bukan secret.
NEXT_PUBLIC_WA_NUMBER=6282124723648
